# Nymfo Casino — copia a .env y edita. NUNCA subas .env al repositorio.

# ── PostgreSQL (docker compose) ──
# Usuario de la base de datos.
POSTGRES_USER=nymfo
# Contraseña de la base de datos (cámbiala).
POSTGRES_PASSWORD=change-me
# Nombre de la base de datos.
POSTGRES_DB=nymfo
# URL para correr la api fuera de Docker (en compose se construye sola con las variables de arriba).
DATABASE_URL=postgresql://nymfo:change-me@localhost:5432/nymfo?schema=public
# Postgres de pruebas (docker-compose.test.yml, puerto 5433).
TEST_DATABASE_URL=postgresql://nymfo_test:nymfo_test@localhost:5433/nymfo_test?schema=public

# ── API ──
# development | test | production.
NODE_ENV=development
# Puerto HTTP de la api (fuera de Docker).
PORT=4000
# Orígenes permitidos por CORS, separados por coma. Se suman los orígenes de PUBLIC_WEB_URL y BACKOFFICE_URL;
# fuera de producción también los localhost de desarrollo (:3000 y :3001).
CORS_ORIGINS=
# Secreto de firma JWT de acceso, mínimo 32 caracteres. OBLIGATORIO. Genera uno: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
# Duración del access token.
ACCESS_TOKEN_TTL=15m
# Días de validez del refresh token.
REFRESH_TOKEN_TTL_DAYS=30
# Operador por defecto cuando el host (X-Operator-Host o Host) no está registrado en OperatorDomain.
# Un X-Operator-Slug explícito e inválido sigue dando 404.
DEFAULT_OPERATOR_SLUG=nymfo
# En producción el operador por defecto solo se usa con ALLOW_DEFAULT_OPERATOR=true (false).
ALLOW_DEFAULT_OPERATOR=false
# URL pública de la api (callbacks/webhooks de los PSP). Vacía en local con proxy.
PUBLIC_API_URL=
# URL pública de la web (redirecciones tras el pago; su origen entra en CORS y en frame-ancestors del juego mock).
PUBLIC_WEB_URL=
# URL pública del backoffice (su origen entra en CORS).
BACKOFFICE_URL=
# Cada cuántos minutos corre el job de reconciliación.
RECONCILIATION_INTERVAL_MINUTES=60
# Contraseña de los usuarios creados por el seed (solo desarrollo).
SEED_ADMIN_PASSWORD=change-me
# Dominios extra que el seed registra en OperatorDomain (vista previa), separados por coma:
# `host` (operador nymfo) o `slug=host`. Ej.: preview.example.com,aurora=aurora-preview.example.com
SEED_EXTRA_DOMAINS=

# ── Passimpay (cripto). Vacío = adaptador deshabilitado ──
# ID de plataforma de Passimpay.
PASSIMPAY_PLATFORM_ID=
# API key de Passimpay (secreto; firma HMAC).
PASSIMPAY_API_KEY=
# URL base de la API de Passimpay.
PASSIMPAY_BASE_URL=https://api.passimpay.io
# IPs permitidas para el webhook, separadas por coma (vacío = sin filtro por IP).
PASSIMPAY_WEBHOOK_IP_ALLOWLIST=

# ── Wompi. Vacío = adaptador deshabilitado ──
# Llave pública de Wompi.
WOMPI_PUBLIC_KEY=
# Llave privada de Wompi.
WOMPI_PRIVATE_KEY=
# Secreto de eventos (verifica la firma del webhook).
WOMPI_EVENTS_SECRET=
# Secreto de integridad (firma de transacciones).
WOMPI_INTEGRITY_SECRET=
# URL base de la API de Wompi (sandbox: https://sandbox.wompi.co/v1).
WOMPI_BASE_URL=https://production.wompi.co/v1

# ── Web (Next.js; las NEXT_PUBLIC_* se incrustan en el build) ──
# Base de la api vista desde el navegador: ruta del mismo origen (/api-proxy, reescrita por Next a API_INTERNAL_URL)
# o URL absoluta. En la vista previa: /_svc/api.
NEXT_PUBLIC_API_URL=/api-proxy
# Origen de socket.io (vacío = mismo origen de la página).
NEXT_PUBLIC_SOCKET_URL=
# Ruta de socket.io (/api-proxy/socket.io; en la vista previa /_svc/api/socket.io).
NEXT_PUBLIC_SOCKET_PATH=/api-proxy/socket.io
# Orígenes extra de proveedores de juegos permitidos en el iframe (frame-src), separados por espacio o coma.
NEXT_PUBLIC_GAME_FRAME_ORIGINS=
# URL pública del sitio (p. ej. https://casino.example.com): base de las URLs absolutas de Open Graph al compartir enlaces.
NEXT_PUBLIC_SITE_URL=
# URL interna de la api para los rewrites de Next (en compose: http://api:4000).
API_INTERNAL_URL=http://localhost:4000

# ── Backoffice (apps/backoffice, Next.js en el puerto 3001; se incrustan en el build) ──
# Subruta donde se sirve el backoffice (basePath/assetPrefix), p. ej. /_svc/backoffice. Vacío = raíz.
BACKOFFICE_BASE_PATH=
# Base de la api vista desde el navegador del backoffice (/api-proxy o URL absoluta cuyo origen esté en CORS).
BACKOFFICE_API_URL=/api-proxy
# Login simulado de desarrollo (solo con `next dev`; en producción se ignora siempre). Déjalo en false.
NEXT_PUBLIC_BACKOFFICE_MOCK_AUTH=false

# ── Módulos Nymfo (Hub, Studios, marketing, promociones). Montados por registerModules en app.ts ──
# true | false. Con false la API arranca sin módulos (solo Fase 1). Por defecto true.
MODULES_ENABLED=true
# Todas son opcionales salvo los secretos marcados. Los valores por defecto están entre paréntesis.
# Prefijo con que el NAVEGADOR llega a la api para el juego del MockProvider (iframe). Absoluto o ruta.
# Vacío = PUBLIC_API_URL o /api-proxy. En la vista previa: /_svc/api.
HUB_PUBLIC_API_URL=
# Base interna (servidor a servidor) del juego mock hacia /hub/v1/wallet/* (http://127.0.0.1:${PORT}).
HUB_INTERNAL_API_URL=
# Base de la web para los juegos de Studios. Vacía (y PUBLIC_WEB_URL vacía) = URL de launch RELATIVA
# (/studio/<id>?…) que el iframe resuelve contra el origen de la web.
WEB_URL=
# Minutos de vida de una sesión de juego del Hub (240).
HUB_SESSION_TTL_MIN=
# Reintentos y timeout (ms) al llamar a la billetera de un casino remoto (3 y 5000).
HUB_REMOTE_WALLET_RETRIES=
HUB_REMOTE_WALLET_TIMEOUT_MS=
# Saldo demo del Hub, en unidades menores (100000000).
HUB_DEMO_BALANCE=
# Operador usado cuando la petición no trae tenant (default).
HUB_DEFAULT_OPERATOR_ID=
# Ruta de lanzamiento de los juegos Studio (/studio).
HUB_STUDIO_LAUNCH_PATH=
# 1 = activa el proveedor simulado (fuera de producción siempre activo). Nunca 1 en producción.
HUB_MOCK_PROVIDER=0
# Secreto HMAC del proveedor simulado (solo con HUB_MOCK_PROVIDER=1).
HUB_PROVIDER_MOCK_PROVIDER_SECRET=
# Secretos HMAC de proveedores entrantes: HUB_PROVIDER_<ID>_SECRET (ID en mayúsculas, '-' → '_').
HUB_PROVIDER_PRAGMATIC_PLAY_SECRET=
HUB_PROVIDER_EVOLUTION_SECRET=
HUB_PROVIDER_AGGREGATOR_SECRET=
# Pragmatic Play: URL de la API y código de login seguro.
HUB_PRAGMATIC_API_URL=
HUB_PRAGMATIC_SECURE_LOGIN=
# Evolution: URL, clave de casino y token de API.
HUB_EVOLUTION_API_URL=
HUB_EVOLUTION_CASINO_KEY=
HUB_EVOLUTION_API_TOKEN=
# Agregador genérico (SoftSwiss/Slotegrator/Hub88): ID, URL y ID de operador en el agregador.
HUB_AGGREGATOR_ID=
HUB_AGGREGATOR_API_URL=
HUB_AGGREGATOR_OPERATOR_ID=
# ── Agregadores reales (callback único: POST /hub/v1/providers/<id>/callback[/<entorno>]) ──
# API-Matic: API key (uks_ = sandbox, ukp_ = producción) y secreto HEX. Configuración parcial = error de arranque.
# Con key de producción el host es siempre https://api.api-matic.com. URL de postbacks a registrar en API-Matic:
#   <PUBLIC_API_URL>/hub/v1/providers/api-matic/callback/sandbox  (o .../produccion)
HUB_APIMATIC_API_KEY=
HUB_APIMATIC_SECRET_KEY=
# Host de la API (por defecto sandbox; ignorado con key ukp_).
HUB_APIMATIC_HOST=
# Moneda con la que se pide el catálogo (obligatoria para sincronizar).
HUB_APIMATIC_CATALOG_CURRENCY=
# Moneda del ledger → código de API-Matic, p. ej. ARS:ARS_PA (sin entrada se envía igual).
HUB_APIMATIC_CURRENCY_MAP=
# Ruta exacta que API-Matic llama y firma, si un proxy la reescribe (p. ej. /_svc/api/hub/v1/providers/api-matic/callback/sandbox).
HUB_APIMATIC_CALLBACK_PATH=
# IPs/CIDR permitidos para los postbacks (vacío = sin restricción; recomendado en producción).
HUB_APIMATIC_ALLOWED_IPS=
# API-Slots: partner y api_key (van juntas). URL de callbacks a registrar: <PUBLIC_API_URL>/hub/v1/providers/api-slots/callback
HUB_APISLOTS_PARTNER_ID=
HUB_APISLOTS_API_KEY=
HUB_APISLOTS_API_URL=
HUB_APISLOTS_CDN_BASE=
HUB_APISLOTS_ALLOWED_IPS=
# Licencia por provider_code (el agregador no la informa): PragmaticPlay:official,AlgunaCopia:clone.
# Solo se sincronizan los "official"; 1 = incluir proveedores sin clasificar. Los "clone" solo con HUB_ALLOW_CLONE_GAMES=1.
HUB_APISLOTS_GAME_TYPES=
HUB_APISLOTS_INCLUDE_UNKNOWN=
HUB_ALLOW_CLONE_GAMES=

# Casino remoto saliente: secreto por casino, HUB_REMOTE_<ID>_SECRET (ID en mayúsculas).
# HUB_REMOTE_CASINO_X_SECRET=

# Studios: saldo demo y monedas (1000000, USD, USD); crash en directo y tiempos (true, 5000, 3000).
STUDIO_DEMO_BALANCE=
STUDIO_DEMO_CURRENCY=
STUDIO_DEFAULT_CURRENCY=
STUDIO_CRASH_LIVE=
STUDIO_CRASH_WAIT_MS=
STUDIO_CRASH_PAUSE_MS=

# Marketing: scheduler (on | off, por defecto activo), intervalo del tick (60000 ms).
MKT_SCHEDULER=
MKT_TICK_INTERVAL_MS=
# Secreto para firmar los enlaces de baja. OBLIGATORIO en producción (MODULES_ENABLED=true), mínimo 32 caracteres. Genera uno: openssl rand -hex 32
MKT_UNSUBSCRIBE_SECRET=
# Límite de frecuencia por jugador (1 envío cada 24 h por defecto) y ventana de conversión (7 días).
MKT_FREQUENCY_CAP_MAX=
MKT_FREQUENCY_CAP_HOURS=
MKT_CONVERSION_WINDOW_DAYS=
# URL pública base de los enlaces de marketing (PUBLIC_API_URL; vacía = rutas relativas) y dominios permitidos (lista separada por coma).
MKT_PUBLIC_BASE_URL=
MKT_LINK_ALLOWLIST=
# Remitentes de los canales de email y SMS. Credenciales de proveedor: ver apps/api/src/modules/marketing/.env.example.
MKT_EMAIL_FROM=
MKT_SMS_FROM=

# Promociones: secreto HMAC de los drops. OBLIGATORIO en producción (MODULES_ENABLED=true), mínimo 32 caracteres. Moneda y tick (USD, 60000 ms).
PROMO_DROPS_SECRET=
PROMO_DEFAULT_CURRENCY=
PROMO_TICK_INTERVAL_MS=

# Feed de apuestas en vivo del lobby. Secreto HMAC de los alias públicos: OBLIGATORIO en producción (MODULES_ENABLED=true),
# mínimo 32 caracteres (openssl rand -hex 32). Prefijo del alias (Jugador), apuesta mínima de "grandes apostadores" por moneda
# en unidades mínimas (USD:100000 = 1000 USD; sin la moneda, nadie entra en esa lista), multiplicador de "grandes victorias" (10)
# y ventana de agrupado del socket en ms (300).
FEED_PSEUDONYM_SECRET=
FEED_PSEUDONYM_PREFIX=
FEED_HIGH_ROLLER_MIN=
FEED_LUCKY_MULTIPLIER=
FEED_FLUSH_MS=

# ── Desarrollo y pruebas (no usar en producción) ──
# dev:modules (apps/api/src/modules/dev-server.ts): jugadores sembrados en formato operador:jugador, separados por coma (op-demo:player-demo).
DEV_PLAYERS=
# Orígenes de CORS del dev-server (DEV_CORS_ORIGINS || CORS_ORIGINS; por defecto http://localhost:3000,http://localhost:3001).
DEV_CORS_ORIGINS=
# 1 = ejecuta las pruebas RTP largas (npm test no las corre sin esto).
RTP_LONG=
# Postgres de pruebas para promociones (Prisma), con schema propio: ...?schema=promo_test.
PROMO_TEST_DATABASE_URL=
# Desactiva la reconciliación periódica del servidor (true).
RECONCILIATION_DISABLED=

