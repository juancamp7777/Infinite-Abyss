{
  "name": "nymfo-api",
  "version": "1.0.0",
  "description": "Nymfo Casino API",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "prisma migrate deploy && tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "simulate:webhook": "tsx scripts/simulate-webhook.ts",
    "test:long": "RTP_LONG=1 vitest run",
    "sim": "tsx src/modules/studio/scripts/sim.ts",
    "dev:modules": "tsx src/modules/dev-server.ts",
    "prisma:modules": "prisma validate",
    "bootstrap": "tsx scripts/bootstrap.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.22.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
