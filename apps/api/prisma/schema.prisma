// Infinite Abyss — esquema multi-operador con ledger de doble partida.
// Todos los montos son BigInt en unidades mínimas de la moneda (ver docs/contracts.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum OperatorStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum BackofficeRole {
  PLATFORM_ADMIN
  OPERATOR_ADMIN
  OPERATOR_SUPPORT
  OPERATOR_FINANCE
}

enum LedgerOwnerType {
  PLAYER
  OPERATOR
}

enum LedgerAccountType {
  PLAYER_CASH
  PLAYER_BONUS
  HOUSE
  PSP_CLEARING
  WITHDRAWAL_PENDING
  BONUS_EXPENSE
  MANUAL_ADJUSTMENT
  DEMO_FUNDING
  JACKPOT_POOL
  TOURNAMENT_POOL
  CASHBACK_EXPENSE
}

enum LedgerTxType {
  DEPOSIT
  WITHDRAWAL_RESERVE
  WITHDRAWAL_RELEASE
  WITHDRAWAL_PAYOUT
  BET
  WIN
  ROLLBACK
  MANUAL_ADJUSTMENT
  DEMO_CREDIT
  BONUS_GRANT
  BONUS_CONVERT
  BONUS_FORFEIT
  CASHBACK
  JACKPOT_CONTRIBUTION
  JACKPOT_PAYOUT
  TOURNAMENT_BUYIN
  TOURNAMENT_PRIZE
  REFUND
}

enum PaymentProviderCode {
  PASSIMPAY
  WOMPI
  PEARL
}

enum DepositStatus {
  CREATED
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
}

enum WithdrawalStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSING
  PAID
  FAILED
}

enum AuditActorType {
  BACKOFFICE_USER
  PLAYER
  SYSTEM
}

enum GameType {
  ROULETTE
  SLOTS
  BLACKJACK
  MINES
  CRASH
  PLINKO
}

enum GameStatus {
  ACTIVE
  FINISHED
}

// ───────────────────────── Tenants ─────────────────────────

model Operator {
  id                    String         @id @default(uuid()) @db.Uuid
  slug                  String         @unique
  name                  String
  status                OperatorStatus @default(ACTIVE)
  defaultCurrency       String
  currencies            String[]
  chipsEnabled          Boolean        @default(false)
  // ÚNICA definición de la tasa de fichas: unidades mínimas por 1 ficha.
  chipMinorUnitsPerChip BigInt?
  // Configuración de límites del operador (validada en código con zod).
  limits                Json           @default("{}")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  domains         OperatorDomain[]
  brand           OperatorBrand?
  users           User[]
  backofficeUsers BackofficeUser[]
  rgSettings      ResponsibleGamingSettings[]
  playerSessions  PlayerSession[]
  refreshTokens   RefreshToken[]
  ledgerAccounts  LedgerAccount[]
  ledgerTxs       LedgerTransaction[]
  ledgerEntries   LedgerEntry[]
  deposits        Deposit[]
  withdrawals     Withdrawal[]
  auditLogs       AuditLog[]
  gameSessions    GameSession[]
}

model OperatorDomain {
  id         String   @id @default(uuid()) @db.Uuid
  host       String   @unique
  operatorId String   @db.Uuid
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([operatorId])
}

model OperatorBrand {
  id          String   @id @default(uuid()) @db.Uuid
  operatorId  String   @unique @db.Uuid
  operator    Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  displayName String
  logoUrl     String
  faviconUrl  String?
  // { primary, secondary, accent, background, surface, text }
  colors      Json
  fontFamily  String
  // { termsUrl, privacyUrl, responsibleGamingText, licenseText, minAge }
  legal       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ───────────────────────── Cuentas ─────────────────────────

model User {
  id              String     @id @default(uuid()) @db.Uuid
  operatorId      String     @db.Uuid
  operator        Operator   @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  email           String
  emailNormalized String
  username        String?
  passwordHash    String
  status          UserStatus @default(ACTIVE)
  kycStatus       KycStatus  @default(NONE)
  currency        String
  isDemo          Boolean    @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  rgSettings     ResponsibleGamingSettings?
  sessions       PlayerSession[]
  refreshTokens  RefreshToken[]
  gameSessions   GameSession[]
  ledgerAccounts LedgerAccount[]
  deposits       Deposit[]
  withdrawals    Withdrawal[]

  @@unique([operatorId, emailNormalized])
  @@unique([operatorId, username])
  @@index([operatorId])
}

model ResponsibleGamingSettings {
  id                      String    @id @default(uuid()) @db.Uuid
  userId                  String    @unique @db.Uuid
  user                    User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  operatorId              String    @db.Uuid
  operator                Operator  @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  depositLimitDaily       BigInt?
  depositLimitWeekly      BigInt?
  depositLimitMonthly     BigInt?
  lossLimitDaily          BigInt?
  lossLimitWeekly         BigInt?
  lossLimitMonthly        BigInt?
  sessionTimeLimitMinutes Int?
  selfExcludedUntil       DateTime?
  selfExclusionPermanent  Boolean   @default(false)
  coolOffUntil            DateTime?
  // Aumentos de límite pendientes de periodo de enfriamiento.
  pendingLimitIncrease    Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([operatorId])
}

model PlayerSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  operatorId String    @db.Uuid
  operator   Operator  @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  startedAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  endedAt    DateTime?

  @@index([userId, startedAt])
  @@index([operatorId])
}

model BackofficeUser {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique // normalizado (minúsculas, sin espacios)
  passwordHash String
  role         BackofficeRole
  // null solo para PLATFORM_ADMIN
  operatorId   String?        @db.Uuid
  operator     Operator?      @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  status       UserStatus     @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  refreshTokens RefreshToken[]

  @@index([operatorId])
}

model RefreshToken {
  id               String          @id @default(uuid()) @db.Uuid
  tokenHash        String          @unique
  userId           String?         @db.Uuid
  user             User?           @relation(fields: [userId], references: [id], onDelete: Restrict)
  backofficeUserId String?         @db.Uuid
  backofficeUser   BackofficeUser? @relation(fields: [backofficeUserId], references: [id], onDelete: Restrict)
  operatorId       String?         @db.Uuid
  operator         Operator?       @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?         @db.Uuid
  ip               String?
  userAgent        String?
  createdAt        DateTime        @default(now())

  @@index([userId])
  @@index([backofficeUserId])
}

// ───────────────────────── Ledger ─────────────────────────

model LedgerAccount {
  id         String            @id @default(uuid()) @db.Uuid
  operatorId String            @db.Uuid
  operator   Operator          @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  ownerType  LedgerOwnerType
  userId     String?           @db.Uuid
  user       User?             @relation(fields: [userId], references: [id], onDelete: Restrict)
  // userId o 'OPERATOR' (evita problemas de unicidad con NULL)
  ownerKey   String
  type       LedgerAccountType
  currency   String
  // Saldo cacheado; debe ser igual a la suma de sus entradas.
  balance    BigInt            @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  entries LedgerEntry[]

  @@unique([operatorId, ownerKey, type, currency])
  @@index([userId])
}

model LedgerTransaction {
  id                        String       @id @default(uuid()) @db.Uuid
  operatorId                String       @db.Uuid
  operator                  Operator     @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  type                      LedgerTxType
  idempotencyKey            String
  currency                  String
  referenceType             String?
  referenceId               String?
  reversesId                String?      @unique @db.Uuid
  metadata                  Json?
  createdByBackofficeUserId String?      @db.Uuid
  createdAt                 DateTime     @default(now())

  entries LedgerEntry[]

  @@unique([operatorId, idempotencyKey])
  @@index([operatorId, createdAt])
  @@index([referenceType, referenceId])
}

model LedgerEntry {
  id            String            @id @default(uuid()) @db.Uuid
  transactionId String            @db.Uuid
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  accountId     String            @db.Uuid
  account       LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  operatorId    String            @db.Uuid
  operator      Operator          @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  // Con signo: débito/crédito según la convención de docs/contracts.md
  amount        BigInt
  currency      String
  createdAt     DateTime          @default(now())

  @@index([accountId])
  @@index([transactionId])
  @@index([operatorId, currency])
}

// ───────────────────────── Cajero ─────────────────────────

model Deposit {
  id                  String              @id @default(uuid()) @db.Uuid
  operatorId          String              @db.Uuid
  operator            Operator            @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  userId              String              @db.Uuid
  user                User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  provider            PaymentProviderCode
  status              DepositStatus       @default(CREATED)
  amount              BigInt
  currency            String
  // orderId que enviamos al PSP
  providerReference   String              @unique
  externalId          String?
  ledgerTransactionId String?             @unique @db.Uuid
  rawCreateResponse   Json?
  confirmedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([provider, externalId])
  @@index([operatorId, userId])
}

model Withdrawal {
  id                         String              @id @default(uuid()) @db.Uuid
  operatorId                 String              @db.Uuid
  operator                   Operator            @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  userId                     String              @db.Uuid
  user                       User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  provider                   PaymentProviderCode
  status                     WithdrawalStatus    @default(REQUESTED)
  amount                     BigInt
  currency                   String
  destination                Json
  externalId                 String?
  reserveLedgerTxId          String              @db.Uuid
  settleLedgerTxId           String?             @db.Uuid
  reviewedByBackofficeUserId String?             @db.Uuid
  reviewedAt                 DateTime?
  rejectionReason            String?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  @@index([operatorId, status])
  @@index([userId])
}

model WebhookEvent {
  id             String              @id @default(uuid()) @db.Uuid
  provider       PaymentProviderCode
  // NULL cuando la firma es inválida (no deduplica eventos no confiables)
  dedupeKey      String?
  signatureValid Boolean
  headers        Json
  rawBody        String              @db.Text
  parsed         Json?
  sourceIp       String?
  processedAt    DateTime?
  result         String?
  error          String?
  receivedAt     DateTime            @default(now())

  @@unique([provider, dedupeKey])
  @@index([receivedAt])
}

model AuditLog {
  id         String         @id @default(uuid()) @db.Uuid
  operatorId String?        @db.Uuid
  operator   Operator?      @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  actorType  AuditActorType
  actorId    String?
  action     String
  targetType String
  targetId   String
  reason     String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime       @default(now())

  @@index([operatorId, createdAt])
  @@index([targetType, targetId])
}

// ───────────────────────── Juegos ─────────────────────────

model GameSession {
  id         String     @id @default(uuid()) @db.Uuid
  operatorId String     @db.Uuid
  operator   Operator   @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  userId     String     @db.Uuid
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  gameType   GameType
  status     GameStatus @default(ACTIVE)
  betAmount  BigInt
  currency   String
  state      Json // Estado específico del juego (cartas, minas, etc.)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([operatorId, userId])
}

// ═════════════════════════ Módulos (Hub, Studios, promociones, CRM, marketing, gamificación, backoffice) ═════════════════════════
// Sin relaciones hacia los modelos de la Fase 1: operatorId/playerId se guardan como texto (uuid) sin FK.

// ───────────────────────── Módulo: hub ─────────────────────────

// Infinite Abyss Hub (agregador). Sin relaciones hacia modelos de la Fase 1: operatorId/playerId son String.

model HubProvider {
  id        String   @id
  name      String
  type      String // internal | external | aggregator
  status    String   @default("active")
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  games HubGame[]

  @@map("hub_providers")
}

model HubGame {
  id             String      @id
  providerId     String
  provider       HubProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  externalId     String
  title          String
  category       String // slots | originals | live | table | other
  mechanic       String
  rtp            Decimal     @db.Decimal(5, 2)
  volatility     String
  images         Json
  tags           String[]
  allowedMarkets String[]
  status         String      @default("active")
  hasDemo        Boolean     @default(true)
  releasedAt     DateTime
  popularity     Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([providerId, externalId])
  @@index([category, status])
  @@map("hub_games")
}

model HubOperatorGame {
  operatorId String
  gameId     String
  enabled    Boolean @default(true)
  sortOrder  Int     @default(0)

  @@id([operatorId, gameId])
  @@map("hub_operator_games")
}

model HubSession {
  id               String   @id @db.Uuid
  token            String   @unique
  operatorId       String
  playerId         String
  providerId       String
  gameId           String
  currency         String
  mode             String // real | demo
  walletKind       String // local | remote | demo
  remoteOperatorId String?
  /// Id de sesión del proveedor (p. ej. vendor_session_id de API-Matic): sus callbacks llegan con él.
  externalSessionId String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@unique([providerId, externalSessionId])
  @@index([operatorId, playerId])
  @@map("hub_sessions")
}

model HubRound {
  id              String    @id @db.Uuid
  providerId      String
  providerRoundId String
  operatorId      String
  playerId        String
  gameId          String
  currency        String
  sessionId       String
  betAmount       BigInt    @default(0)
  winAmount       BigInt    @default(0)
  status          String    @default("open") // open | settled | rolled_back
  createdAt       DateTime  @default(now())
  settledAt       DateTime?

  @@unique([providerId, providerRoundId])
  @@index([createdAt, providerId])
  @@index([operatorId, createdAt])
  @@map("hub_rounds")
}

model HubTransaction {
  id              String   @id @db.Uuid
  providerId      String
  providerTxId    String
  type            String // BET | WIN | ROLLBACK | TOMBSTONE
  status          String // ok | rolled_back | tombstone
  operatorId      String
  playerId        String
  currency        String
  amount          BigInt
  providerRoundId String?
  gameId          String?
  sessionId       String?
  referenceTxId   String?
  walletTxId      String?
  fingerprint     String
  response        Json?
  createdAt       DateTime @default(now())

  @@unique([providerId, providerTxId])
  @@index([operatorId, playerId, createdAt])
  @@map("hub_transactions")
}

model HubRemoteOperator {
  id                String   @id
  name              String
  walletCallbackUrl String
  status            String   @default("active")
  currencies        String[]
  createdAt         DateTime @default(now())

  @@map("hub_remote_operators")
}

// ───────────────────────── Módulo: studio ─────────────────────────

// Abyss Studios: rondas, semillas provably fair y configuración de juegos por operador.
// Sin relaciones hacia modelos de la Fase 1: operatorId/playerId son uuid en texto.

model StudioRound {
  id             String   @id @db.Uuid
  operatorId     String
  playerId       String
  gameId         String
  bet            BigInt
  baseBet        BigInt
  win            BigInt   @default(0)
  multiplier     Float    @default(0)
  currency       String
  outcome        Json?
  state          Json?
  params         Json
  rtp            Float
  rtpProfile     String?
  bonusBuy       Boolean  @default(false)
  serverSeedHash String
  clientSeed     String
  nonce          Int
  seedPairId     String   @db.Uuid
  status         String // OPEN | SETTLED | ROLLED_BACK | FAILED
  mode           String // real | demo
  debits         Int      @default(1)
  version        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([operatorId, playerId, createdAt])
  @@index([operatorId, playerId, gameId, status])
  @@index([seedPairId])
  @@map("studio_rounds")
}

model StudioSeedPair {
  id             String    @id @db.Uuid
  operatorId     String
  playerId       String
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  nonce          Int       @default(0)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  revealedAt     DateTime?

  @@index([operatorId, playerId, active])
  @@map("studio_seed_pairs")
}

model StudioOperatorConfig {
  operatorId String
  gameId     String
  rtp        Float?
  rtpProfile String?
  minBet     BigInt?
  maxBet     BigInt?
  enabled    Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  @@id([operatorId, gameId])
  @@map("studio_operator_configs")
}

// ───────────────────────── Módulo: promotions ─────────────────────────

// Módulo de promociones (Infinite Abyss): bonos con wagering, jackpots progresivos y drops & wins.
// Sin relaciones hacia modelos de la Fase 1: jugadores y operadores se referencian por id (String uuid).
// Montos en unidades mínimas (BigInt); porcentajes en basis points (Int); probabilidades en ppm (Int).

model PromoBonusTemplate {
  id                String    @id @default(uuid()) @db.Uuid
  operatorId        String
  name              String
  type              String // deposit_match | free_spins | cashback | promo_code
  status            String    @default("ACTIVE") // ACTIVE | INACTIVE
  currency          String
  code              String?
  maxUsesTotal      Int?
  maxUsesPerPlayer  Int?
  usesCount         Int       @default(0)
  validFrom         DateTime?
  validTo           DateTime?
  autoOnDeposit     Boolean   @default(false)
  firstDepositOnly  Boolean   @default(false)
  stackable         Boolean   @default(false)
  matchBps          Int?
  minDeposit        BigInt?
  maxBonusAmount    BigInt?
  fixedAmount       BigInt?
  freeSpinGameId    String?
  freeSpinCount     Int?
  freeSpinValue     BigInt?
  cashbackBps       Int?
  wageringMultiplier Int      @default(0)
  wageringBase      String    @default("BONUS") // BONUS | BONUS_PLUS_DEPOSIT
  contributionBps   Json
  excludedGameIds   String[]
  maxBet            BigInt?
  maxConversion     BigInt?
  validityHours     Int       @default(168)
  claimWindowHours  Int       @default(24)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  redemptions PromoCodeRedemption[]

  @@unique([operatorId, code])
  @@index([operatorId, type, status])
  @@map("promo_bonus_templates")
}

model PromoCodeRedemption {
  id         String             @id @default(uuid()) @db.Uuid
  templateId String             @db.Uuid
  template   PromoBonusTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  playerId   String
  createdAt  DateTime           @default(now())

  @@index([templateId, playerId])
  @@map("promo_code_redemptions")
}

model PromoPlayerBonus {
  id                 String    @id @default(uuid()) @db.Uuid
  operatorId         String
  playerId           String
  templateId         String?   @db.Uuid
  type               String
  status             String // PENDING | ACTIVE | COMPLETED | FORFEITED | CANCELLED
  phase              String    @default("WAGERING") // SPINS | WAGERING
  currency           String
  source             String // CODE | DEPOSIT | MANUAL | CASHBACK | SERVICE
  sourceRef          String?
  amount             BigInt    @default(0)
  depositAmount      BigInt    @default(0)
  wageringMultiplier Int       @default(0)
  wageringBase       String    @default("BONUS")
  wageringRequired   BigInt    @default(0)
  wageringProgress   BigInt    @default(0)
  contributionBps    Json
  excludedGameIds    String[]
  maxBet             BigInt?
  maxConversion      BigInt?
  freeSpinGameId     String?
  freeSpinsTotal     Int       @default(0)
  freeSpinsUsed      Int       @default(0)
  freeSpinsSettled   Int       @default(0)
  freeSpinValue      BigInt?
  freeSpinWin        BigInt    @default(0)
  validityHours      Int       @default(168)
  expiresAt          DateTime?
  grantTxId          String?
  settlementAmount   BigInt    @default(0)
  settlementTxId     String?
  statusReason       String?
  createdAt          DateTime  @default(now())
  activatedAt        DateTime?
  closedAt           DateTime?

  rounds PromoBonusRound[]

  @@unique([operatorId, sourceRef])
  @@index([operatorId, playerId, status])
  @@index([status, expiresAt])
  @@map("promo_player_bonuses")
}

/// Dedupe por ronda del wagering (kind w), del consumo de giros gratis (fs) y de sus ganancias (fsw).
model PromoBonusRound {
  bonusId      String           @db.Uuid
  bonus        PromoPlayerBonus @relation(fields: [bonusId], references: [id], onDelete: Cascade)
  key          String // "<kind>:<roundId>"
  contribution BigInt           @default(0)
  createdAt    DateTime         @default(now())

  @@id([bonusId, key])
  @@map("promo_bonus_rounds")
}

/// Rondas liquidadas (bet.settled) para calcular el cashback por pérdida neta del periodo.
model PromoSettledRound {
  operatorId String
  roundId    String
  playerId   String
  currency   String
  amount     BigInt
  win        BigInt
  settledAt  DateTime

  @@id([operatorId, roundId])
  @@index([operatorId, currency, settledAt])
  @@map("promo_settled_rounds")
}

model PromoJackpot {
  id              String   @id @default(uuid()) @db.Uuid
  operatorId      String
  name            String
  currency        String
  contributionBps Int
  minBet          BigInt   @default(0)
  gameIds         String[]
  categories      String[]
  status          String   @default("ACTIVE") // ACTIVE | PAUSED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  levels PromoJackpotLevel[]

  @@index([operatorId, status])
  @@map("promo_jackpots")
}

model PromoJackpotLevel {
  id               String       @id @default(uuid()) @db.Uuid
  jackpotId        String       @db.Uuid
  jackpot          PromoJackpot @relation(fields: [jackpotId], references: [id], onDelete: Cascade)
  key              String // mini | major | mega
  seedAmount       BigInt
  shareBps         Int
  triggerChancePpm Int
  mustDropBy       BigInt?
  dropPoint        BigInt?
  currentAmount    BigInt
  sortOrder        Int

  @@unique([jackpotId, key])
  @@map("promo_jackpot_levels")
}

model PromoJackpotContribution {
  id         String   @id @default(uuid()) @db.Uuid
  jackpotId  String   @db.Uuid
  operatorId String
  playerId   String
  roundId    String
  gameId     String
  betAmount  BigInt
  amount     BigInt
  /// { "mini": "12", "major": "30", ... } (montos como string)
  perLevel   Json
