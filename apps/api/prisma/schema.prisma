  memberId   String   @db.Uuid
  type       String
  xp         Int
  value      Int?
  refKey     String   @unique
  at         DateTime @default(now())

  @@index([operatorId, at])
  @@index([memberId, at])
  @@map("crew_activities")
}

model CrewResponseClock {
  conversationId String    @id @db.Uuid
  operatorId     String
  waitingSince   DateTime?

  @@map("crew_response_clocks")
}

// ───────────────────────── Reef: plantillas white-label ─────────────────────────

model ReefSiteDraft {
  operatorId String   @id
  config     Json
  updatedBy  String
  updatedAt  DateTime @updatedAt

  @@map("reef_site_drafts")
}

model ReefSiteVersion {
  id          String   @id @default(uuid()) @db.Uuid
  operatorId  String
  version     Int
  status      String
  config      Json
  publishedBy String
  publishedAt DateTime @default(now())

  @@unique([operatorId, version])
  @@index([operatorId, status])
  @@map("reef_site_versions")
}

model ReefAsset {
  id         String   @id @default(uuid()) @db.Uuid
  operatorId String
  mime       String
  size       Int
  data       Bytes
  createdAt  DateTime @default(now())

  @@index([operatorId])
  @@map("reef_assets")
}

// ───────────────────────── Integraciones (Abyss Command) ─────────────────────────

// Credenciales de servicios externos (IA, proveedores de juegos, pagos, alertas). scope = 'platform' o el id del casino.
// Los secretos van cifrados (AES-256-GCM, INBOX_SECRETS_KEY); publicFields guarda solo datos no sensibles (URLs, IDs).
model IntegrationCredential {
  scope        String
  key          String
  secretsEnc   String?
  publicFields Json      @default("{}")
  status       String    @default("saved")
  lastError    String?
  lastTestAt   DateTime?
  updatedBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@id([scope, key])
  @@map("integration_credentials")
}
