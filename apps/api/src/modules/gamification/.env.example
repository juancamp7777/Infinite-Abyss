# Gamificación (apps/api/src/modules/gamification)
# La moneda de rakeback, rueda, rachas y torneos sale del jugador o del defaultCurrency del operador
# (ajustes del operador si la fijan). Esta variable es solo respaldo del dev-server de módulos
# (sin operador real); si falta se usa USD.
# GAMIFICATION_DEFAULT_CURRENCY=USD
