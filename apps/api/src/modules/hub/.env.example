# Infinite Abyss Hub (agregador). Sin valores reales: rellenar en el entorno de cada despliegue.

# URL pública del frontend del jugador (launch de juegos de Abyss Studios). Si WEB_URL y PUBLIC_WEB_URL están vacías,
# la URL de launch es RELATIVA (/studio/<gameId>?…) y el iframe de la web la resuelve contra su propio origen.
WEB_URL=
# Ruta del host de juegos de Studios en apps/web (URL final: ${WEB_URL}${HUB_STUDIO_LAUNCH_PATH}/<gameId>?mode=&session=)
HUB_STUDIO_LAUNCH_PATH=/studio
# Prefijo con que el NAVEGADOR llega a esta API (servidor de juego mock). Absoluta o ruta; default PUBLIC_API_URL || /api-proxy
HUB_PUBLIC_API_URL=
# Base interna (servidor a servidor) para las llamadas del juego mock a /hub/v1/wallet/*; default http://127.0.0.1:${PORT}
HUB_INTERNAL_API_URL=
# Operador por defecto para lanzar demos sin login
HUB_DEFAULT_OPERATOR_ID=
# Duración de las sesiones de juego (minutos, deslizante) y saldo demo (unidades mínimas)
HUB_SESSION_TTL_MIN=240
HUB_DEMO_BALANCE=100000000

# Proveedor simulado (fuera de producción se activa siempre; 1 = además monta /hub/mock-provider/game/:gameId)
HUB_MOCK_PROVIDER=1
# Secreto HMAC del proveedor mock (si falta, en desarrollo se genera uno aleatorio por proceso)
HUB_PROVIDER_MOCK_PROVIDER_SECRET=

# Secretos HMAC de proveedores entrantes: HUB_PROVIDER_<ID>_SECRET (ID en mayúsculas, '-' → '_')
# Pragmatic Play (se activa solo con las 3 variables)
HUB_PRAGMATIC_API_URL=
HUB_PRAGMATIC_SECURE_LOGIN=
HUB_PROVIDER_PRAGMATIC_PLAY_SECRET=
# Evolution (se activa solo con las 4 variables)
HUB_EVOLUTION_API_URL=
HUB_EVOLUTION_CASINO_KEY=
HUB_EVOLUTION_API_TOKEN=
HUB_PROVIDER_EVOLUTION_SECRET=
# Agregador genérico estilo SoftSwiss/Slotegrator/Hub88 (secreto en HUB_PROVIDER_<HUB_AGGREGATOR_ID>_SECRET)
HUB_AGGREGATOR_ID=aggregator
HUB_AGGREGATOR_API_URL=
HUB_AGGREGATOR_OPERATOR_ID=
HUB_PROVIDER_AGGREGATOR_SECRET=

# ── Agregadores reales (callback único: POST /hub/v1/providers/<id>/callback[/<entorno>]) ──
# API-Matic: API key (uks_ = sandbox, ukp_ = producción) y secreto HEX. Configuración parcial = error de arranque.
# Con key de producción el host es siempre https://api.api-matic.com. URL de postbacks a registrar en API-Matic:
#   <PUBLIC_API_URL>/hub/v1/providers/api-matic/callback/sandbox  (o .../produccion)
HUB_APIMATIC_API_KEY=
HUB_APIMATIC_SECRET_KEY=
# Host de la API (por defecto sandbox; ignorado con key ukp_).
HUB_APIMATIC_HOST=
# Moneda con la que se pide el catálogo (obligatoria para sincronizar).
HUB_APIMATIC_CATALOG_CURRENCY=
# Moneda del ledger → código de API-Matic, p. ej. ARS:ARS_PA (sin entrada se envía igual).
HUB_APIMATIC_CURRENCY_MAP=
# Ruta exacta que API-Matic llama y firma, si un proxy la reescribe (p. ej. /_svc/api/hub/v1/providers/api-matic/callback/sandbox).
HUB_APIMATIC_CALLBACK_PATH=
# IPs/CIDR permitidos para los postbacks (vacío = sin restricción; recomendado en producción).
HUB_APIMATIC_ALLOWED_IPS=
# API-Slots: partner y api_key (van juntas). URL de callbacks a registrar: <PUBLIC_API_URL>/hub/v1/providers/api-slots/callback
HUB_APISLOTS_PARTNER_ID=
HUB_APISLOTS_API_KEY=
HUB_APISLOTS_API_URL=
HUB_APISLOTS_CDN_BASE=
HUB_APISLOTS_ALLOWED_IPS=
# Licencia por provider_code (el agregador no la informa): PragmaticPlay:official,AlgunaCopia:clone.
# Solo se sincronizan los "official"; 1 = incluir proveedores sin clasificar. Los "clone" solo con HUB_ALLOW_CLONE_GAMES=1.
HUB_APISLOTS_GAME_TYPES=
HUB_APISLOTS_INCLUDE_UNKNOWN=
HUB_ALLOW_CLONE_GAMES=

# Lado saliente: secreto por casino remoto HUB_REMOTE_<ID>_SECRET (firma de /outbound/launch y de nuestros callbacks)
# HUB_REMOTE_CASINO_X_SECRET=
HUB_REMOTE_WALLET_RETRIES=3
HUB_REMOTE_WALLET_TIMEOUT_MS=5000
