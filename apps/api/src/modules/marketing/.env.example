# Marketing (sin valores reales; configurar en el entorno del despliegue)
MKT_PUBLIC_BASE_URL=http://localhost:4000
# Secreto HMAC de los enlaces de baja (obligatorio en producción; si falta se usa uno efímero)
MKT_UNSUBSCRIBE_SECRET=
# Dominios permitidos para redirección de clics (coma). Cada operador añade los suyos en su marca.
MKT_LINK_ALLOWLIST=
MKT_FREQUENCY_CAP_MAX=1
MKT_FREQUENCY_CAP_HOURS=24
MKT_CONVERSION_WINDOW_DAYS=7
MKT_SCHEDULER=on
MKT_TICK_INTERVAL_MS=60000
# Email (API HTTP de proveedor transaccional); sin esto se usa LogChannel
MKT_EMAIL_API_URL=
MKT_EMAIL_API_KEY=
MKT_EMAIL_FROM=
# SMS / WhatsApp (esqueletos: requieren contrato del proveedor)
MKT_SMS_API_URL=
MKT_SMS_API_KEY=
MKT_SMS_FROM=
MKT_WHATSAPP_API_URL=
MKT_WHATSAPP_API_KEY=
# Web Push (TODO: envío real pendiente)
MKT_VAPID_PUBLIC_KEY=
MKT_VAPID_PRIVATE_KEY=
MKT_VAPID_SUBJECT=
