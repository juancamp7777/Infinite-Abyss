# Módulo de promociones (apps/api/src/modules/promotions)
# Secreto HMAC de las tiradas de drops & wins (tirada determinista por campaña+ronda). Sin él se usa uno efímero por proceso.
PROMO_DROPS_SECRET=
# Intervalo del job de expiración de bonos y reintentos de pagos (ms). 0 = desactivado.
PROMO_TICK_INTERVAL_MS=60000
# grantCashback sin currency usa el defaultCurrency del operador. Esta variable es solo respaldo del
# dev-server de módulos (sin operador real); si falta se usa USD.
# PROMO_DEFAULT_CURRENCY=USD
# Solo pruebas: base PostgreSQL con el schema fusionado aplicado para correr __tests__/prisma.test.ts.
PROMO_TEST_DATABASE_URL=
