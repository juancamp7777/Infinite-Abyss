# Abyss Studios (apps/api/src/modules/studio)
# Saldo virtual inicial de cada sesión demo, en unidades mínimas. Sin definir: 1.000.000 COP (100000000)
# para operadores en COP y 10 000.00 (1000000) para el resto de monedas.
# STUDIO_DEMO_BALANCE=1000000
# La divisa sale SIEMPRE del jugador (User.currency) o del operador (Operator.defaultCurrency).
# Estas dos variables son solo respaldo del dev-server de módulos (sin operador real); si faltan se usa USD.
# STUDIO_DEMO_CURRENCY=USD
# STUDIO_DEFAULT_CURRENCY=USD
# Crash en vivo compartido en el namespace socket.io /studio ('false' lo desactiva).
STUDIO_CRASH_LIVE=true
STUDIO_CRASH_WAIT_MS=5000
STUDIO_CRASH_PAUSE_MS=3000
