# Prefijo bajo el que se sirve el backoffice (p. ej. /_svc/backoffice). Vacío = raíz. Se fija en el build.
NEXT_PUBLIC_BASE_PATH=
# URL base del API vista desde el navegador. Puede ser absoluta (http://localhost:4000, requiere CORS_ORIGINS en el API)
# o relativa (/_svc/api). Si se omite se usa `${NEXT_PUBLIC_BASE_PATH}/api-proxy`, que Next reenvía a API_INTERNAL_URL (same-origin).
NEXT_PUBLIC_API_URL=
# API interno al que apunta el rewrite /api-proxy/* (lado servidor, se lee al arrancar/construir).
API_INTERNAL_URL=http://localhost:4000
# Orígenes extra permitidos para imágenes/logos de operadores en la CSP (separados por coma).
NEXT_PUBLIC_IMG_ORIGINS=
# Login simulado de desarrollo (dev-server de módulos, `npm run dev:modules` en apps/api, puerto 4000).
# Solo funciona con `next dev`; en producción (next build) se ignora siempre. Déjalo en false.
NEXT_PUBLIC_BACKOFFICE_MOCK_AUTH=false
