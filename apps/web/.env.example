# Base del API. Puede ser absoluta (https://api.ejemplo.com) o relativa same-origin.
# Por defecto '/api-proxy': Next reenvía /api-proxy/* a API_INTERNAL_URL (incluye Socket.io).
# Detrás de un proxy con prefijo: NEXT_PUBLIC_API_URL=/_svc/api
# Sin secretos: todo NEXT_PUBLIC_* es visible en el navegador y se fija en el build.
NEXT_PUBLIC_API_URL=/api-proxy
# Socket.io: origen (vacío = origen actual o el del API absoluto) y path (vacío = <base del API>/socket.io).
NEXT_PUBLIC_SOCKET_URL=
NEXT_PUBLIC_SOCKET_PATH=
# Destino interno de la rewrite /api-proxy/* (solo servidor, en runtime). En docker: http://api:4000
API_INTERNAL_URL=http://localhost:4000
# Orígenes extra permitidos en frame-src (juegos de proveedores externos), separados por espacios o comas.
NEXT_PUBLIC_GAME_FRAME_ORIGINS=
# Opcional: id del operador (tenant) para los endpoints públicos del lobby (Hub, jackpots, skin).
# Si se omite se toma del token de sesión (claim op) o de /api/operator/brand.
# NEXT_PUBLIC_OPERATOR_ID=
# SOLO desarrollo con `npm run dev:modules` (MockAuth): token dev:PLAYER:<operatorId>:<playerId>. Se ignora en producción.
# NEXT_PUBLIC_DEV_TOKEN=dev:PLAYER:op-demo:player-demo

# Webchat embebible (/webchat): orígenes que pueden ponerlo en un iframe (espacios o comas). Vacío = cualquiera.
# Se fija al compilar (next build).
# WEBCHAT_FRAME_ANCESTORS=https://mi-casino.com https://www.mi-casino.com
