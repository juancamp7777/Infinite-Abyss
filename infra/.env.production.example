# Infinite Abyss — variables de producción/staging. Copiar a infra/.env.production (nunca a git) y `chmod 600`.
# Secretos: genera cada uno con `openssl rand -hex 32` (mínimo 32 caracteres; la API no arranca sin ellos).

# ── Imágenes ──
REGISTRY=ghcr.io/juancamp7777
# Etiqueta publicada por el CI (sha del commit) o "latest".
IMAGE_TAG=latest

# ── Dominios (DNS A/AAAA → IP del VPS) y certificados ──
CASINO_DOMAIN=casino.example.com
BACKOFFICE_DOMAIN=admin.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

# ── Base de datos ──
POSTGRES_USER=abyss
POSTGRES_PASSWORD=
POSTGRES_DB=abyss

# ── API (obligatorios en producción) ──
JWT_ACCESS_SECRET=
MKT_UNSUBSCRIBE_SECRET=
PROMO_DROPS_SECRET=
FEED_PSEUDONYM_SECRET=
# Clave de cifrado de credenciales de WhatsApp/Telegram (≥ 32 caracteres; si se pierde, hay que volver a cargarlas).
INBOX_SECRETS_KEY=
# Operador por defecto para hosts no registrados (solo si ALLOW_DEFAULT_OPERATOR=true).
DEFAULT_OPERATOR_SLUG=nymfo
ALLOW_DEFAULT_OPERATOR=false
CORS_ORIGINS=

# ── Pasarelas de pago (vacías = deshabilitadas) ──
PASSIMPAY_PLATFORM_ID=
PASSIMPAY_API_KEY=
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=

# ── Agregadores de juegos (ver .env.example de la raíz para el detalle) ──
HUB_APIMATIC_API_KEY=
HUB_APIMATIC_SECRET_KEY=
HUB_APIMATIC_CATALOG_CURRENCY=
HUB_APIMATIC_ALLOWED_IPS=
HUB_APISLOTS_PARTNER_ID=
HUB_APISLOTS_API_KEY=
HUB_APISLOTS_GAME_TYPES=
HUB_APISLOTS_ALLOWED_IPS=
# Iframes de proveedores permitidos en la web (frame-src), separados por espacio.
NEXT_PUBLIC_GAME_FRAME_ORIGINS=

# ── Feed de apuestas en vivo ──
FEED_HIGH_ROLLER_MIN=

# ── Copias de seguridad ──
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
# Copia externa cifrada con restic (S3 compatible: Backblaze B2, Wasabi, R2…). Vacío = solo local.
# Ej.: s3:https://s3.us-west-004.backblazeb2.com/mi-bucket/abyss
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
