# Infinite Abyss — proxy de entrada con HTTPS automático (Let's Encrypt).
# Dominios por variables: CASINO_DOMAIN, BACKOFFICE_DOMAIN, API_DOMAIN (con *.localhost Caddy usa su CA interna).
#
# Detrás de Cloudflare: EDGE_RANGES son las únicas IPs que pueden conectarse (por defecto, las de Cloudflare:
# https://www.cloudflare.com/ips). Así nadie puede saltarse el WAF atacando la IP del servidor. La IP real del
# jugador llega en CF-Connecting-IP y solo se cree si la conexión viene de Cloudflare.
# Sin Cloudflare (pruebas locales): EDGE_RANGES="0.0.0.0/0 ::/0".
{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
		trusted_proxies static {$EDGE_RANGES:173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32}
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(seguridad) {
	# Conexiones que no vienen del borde (Cloudflare) se cortan sin respuesta.
	@fuera_del_borde not remote_ip {$EDGE_RANGES:173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32}
	abort @fuera_del_borde
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
		-X-Powered-By
	}
	encode zstd gzip
}

# Las rutas de administración del API (login y paneles del backoffice, /…/admin/…) solo existen en BACKOFFICE_DOMAIN,
# que va detrás de Cloudflare Access. En el casino y en la API pública responden 404 (sin distinguir mayúsculas).
(solo_publico) {
	@admin_api path_regexp (?i)/(api/)?backoffice(/|$)|/admin(/|$)
	respond @admin_api 404
}

# /api-proxy/* va directo a la API (también websockets de socket.io); el resto, a cada app.
{$CASINO_DOMAIN} {
	import seguridad
	import solo_publico
	handle_path /api-proxy/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy web:3000
	}
}

# www → dominio principal (una sola URL para buscadores).
www.{$CASINO_DOMAIN} {
	import seguridad
	redir https://{$CASINO_DOMAIN}{uri} permanent
}

{$BACKOFFICE_DOMAIN} {
	import seguridad
	handle_path /api-proxy/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy backoffice:3001
	}
}

# API pública: callbacks de proveedores/agregadores, webhooks de pasarelas y outbound B2B.
{$API_DOMAIN} {
	import seguridad
	import solo_publico
	reverse_proxy api:4000
}
